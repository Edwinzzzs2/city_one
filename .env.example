# Required for the server to connect to PostgreSQL (use Supabase Transaction Pooler in Vercel).
DATABASE_URL=postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# 本地/自建 PostgreSQL 未启用 SSL 时使用普通连接串或显式 sslmode=disable。
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/cityone?sslmode=disable
# 普通 PG 的 SSL 参数原样交给驱动；需要证书验证时配置 sslmode=verify-full 和 sslrootcert。
# 主站只使用 DATABASE_URL；Supabase 保活使用单独的 SUPABASE_KEEPALIVE_* 配置。

# Required for signing login sessions.
AUTH_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Used only when the database has no administrator yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_initial_password

# Optional switch. Login is disabled by default; set this to true to require login on the main app.
# AUTH_ENABLED=false
