# Copy this file to .env.local and fill in your local config.
# .env.local is ignored by git.

DATABASE_URL=postgresql://user:password@localhost:5432/city_one

# AI parse settings
AI_API_BASE_URL=https://your.sub2api.com/v1
AI_API_KEY=your_api_key
AI_MODEL=gpt-5.5

# AMap
NEXT_PUBLIC_AMAP_JS_KEY=your_web_js_api_key
NEXT_PUBLIC_AMAP_SECURITY_CODE=your_web_js_api_security_code
AMAP_WEB_SERVICE_KEY=your_web_service_key

# Umami analytics
# Required to enable tracking. Leave empty to disable.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional. Defaults to https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Optional tracker attributes.
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_UMAMI_DOMAINS=
NEXT_PUBLIC_UMAMI_TAG=
NEXT_PUBLIC_UMAMI_AUTO_TRACK=
NEXT_PUBLIC_UMAMI_DO_NOT_TRACK=
NEXT_PUBLIC_UMAMI_EXCLUDE_SEARCH=
NEXT_PUBLIC_UMAMI_EXCLUDE_HASH=
