# 复制为 .env.supabase-keepalive.local，使用 Node 20.6+ 的 --env-file 参数加载。
# 服务器定时任务每日执行：node --env-file=.env.supabase-keepalive.local scripts/supabase-keepalive.cjs
# 保活配置与主站 DATABASE_URL 独立，不需要填写数据库密码。
SUPABASE_KEEPALIVE_URL=https://couqibjqkteustcupify.supabase.co
# 使用 Supabase Connect 页面中的 publishable key 或项目 anon key。
SUPABASE_KEEPALIVE_KEY=
